@model IEnumerable<WebMVC.Domain.Entities.User>
@{
    ViewData["Title"] = "Користувачі";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h1 class="mb-0">Керування користувачами</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">+ Додати користувача</a>
</div>

<div class="card shadow-sm border-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-primary text-white">
                <tr>
                    <th class="py-3 px-4 border-0">Логін</th>
                    <th class="py-3 border-0">Email</th>
                    <th class="py-3 border-0 text-center">Роль</th>
                    <th class="py-3 border-0 text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="px-4 fw-medium">@user.Username</td>
                        <td>@user.Email</td>
                        <td class="text-center">
                            @if (user.Role == WebMVC.Domain.Entities.UserRole.Admin)
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2">Адмін</span>
                            }
                            else
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-2">Студент</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">Редагувати</a>
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">Деталі</a>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Видалити користувача @user.Username?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
