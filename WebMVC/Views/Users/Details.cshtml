@model WebMVC.Domain.Entities.User
@{
    ViewData["Title"] = "Деталі користувача";
}

<div class="container mt-4" style="max-width: 480px;">
    <h1 class="mb-4">Деталі користувача</h1>
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <dl class="row mb-0">
            <dt class="col-4 text-muted">ID</dt>
            <dd class="col-8">@Model.Id</dd>
            <dt class="col-4 text-muted">Логін</dt>
            <dd class="col-8 fw-medium">@Model.Username</dd>
            <dt class="col-4 text-muted">Email</dt>
            <dd class="col-8">@Model.Email</dd>
            <dt class="col-4 text-muted">Роль</dt>
            <dd class="col-8">
                @if (Model.Role == WebMVC.Domain.Entities.UserRole.Admin)
                {
                    <span class="badge bg-danger rounded-pill px-3">Адмін</span>
                }
                else
                {
                    <span class="badge bg-primary rounded-pill px-3">Студент</span>
                }
            </dd>
        </dl>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4 me-2">Редагувати</a>
        <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Назад</a>
    </div>
</div>
