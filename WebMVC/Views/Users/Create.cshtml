@{
    ViewData["Title"] = "Новий користувач";
}

<div class="container mt-4" style="max-width: 520px;">
    <h1 class="mb-4">Новий користувач</h1>

    <div class="card shadow-sm border-0 rounded-4 p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Логін *</label>
                <input type="text" name="username" class="form-control rounded-3" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control rounded-3" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Пароль *</label>
                <input type="password" name="password" class="form-control rounded-3" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Роль</label>
                <select name="role" class="form-select rounded-3">
                    <option value="1">Студент (StudentAuthor)</option>
                    <option value="0">Адміністратор (Admin)</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 me-2">Створити</button>
            <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Скасувати</a>
        </form>
    </div>
</div>
