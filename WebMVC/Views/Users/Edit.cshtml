@model WebMVC.Domain.Entities.User
@{
    ViewData["Title"] = "Редагування користувача";
}

<div class="container mt-4" style="max-width: 520px;">
    <h1 class="mb-4">Редагування: @Model.Username</h1>

    <div class="card shadow-sm border-0 rounded-4 p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Логін *</label>
                <input type="text" name="username" value="@Model.Username" class="form-control rounded-3" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" value="@Model.Email" class="form-control rounded-3" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Роль</label>
                <select name="role" class="form-select rounded-3">
                    @if (Model.Role == WebMVC.Domain.Entities.UserRole.StudentAuthor)
                    {
                        <option value="1" selected>Студент (StudentAuthor)</option>
                        <option value="0">Адміністратор (Admin)</option>
                    }
                    else
                    {
                        <option value="1">Студент (StudentAuthor)</option>
                        <option value="0" selected>Адміністратор (Admin)</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Новий пароль <span class="text-muted fw-normal">(залиш порожнім, щоб не змінювати)</span></label>
                <input type="password" name="newPassword" class="form-control rounded-3" placeholder="Введіть новий пароль..." />
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 me-2">Зберегти</button>
            <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Скасувати</a>
        </form>
    </div>
</div>
