@model WebMVC.Domain.Entities.Review

@{
    ViewData["Title"] = "Залишити відгук";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h2 class="h4 mb-0 fw-bold">Залишити відгук</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    
                    <div class="alert alert-light border shadow-sm rounded-4 mb-4 p-4 text-center">
                        <p class="mb-0 fs-5 text-dark">
                            Як пройшла співпраця з <span class="fw-bold text-primary">@ViewBag.TeacherName</span> над темою <br/>
                            <span class="fst-italic">"@ViewBag.WorkTitle"</span>?
                        </p>
                    </div>

                    <form asp-action="Create">
                        <input type="hidden" asp-for="WorkId" />
                        <input type="hidden" asp-for="TeacherId" />
                        <input type="hidden" asp-for="StudentId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase tracking-wider d-block text-center">Оцінка (1-5 зірок)</label>
                            <input asp-for="Rating" type="number" class="form-control form-control-lg rounded-pill px-4 text-center mx-auto" 
                                   style="max-width: 150px;" min="1" max="5" placeholder="5" required />
                            <div class="form-text mt-2 text-center">Де 1 — було дуже важко, 5 — ідеально.</div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold small text-uppercase tracking-wider">Твій коментар</label>
                            <textarea asp-for="Comment" class="form-control rounded-4 px-3 py-3" rows="5" 
                                      placeholder="Напиши чесно: чи допомагав викладач, чи вчасно відповідав?"></textarea>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 pt-3 border-top">
                            <a asp-controller="Works" asp-action="Index" class="btn btn-light border rounded-pill px-4 py-2 order-2 order-sm-1">Пропустити (напишу пізніше)</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm order-1 order-sm-2 fw-bold">Опублікувати відгук</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>