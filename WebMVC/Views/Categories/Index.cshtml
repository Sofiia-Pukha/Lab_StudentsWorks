@model IEnumerable<WebMVC.Domain.Entities.Category>

@{
    ViewData["Title"] = "Тематики робіт";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h1 class="mb-0">Тематики робіт</h1>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">+ Додати тематику</a>
</div>

<div class="card shadow-sm border-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-primary text-white">
                <tr>
                    <th class="py-3 px-4 border-0">Назва напрямку (Тематика)</th>
                    <th class="py-3 px-4 border-0 text-end">Дії</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model != null && Model.Any()) {
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold px-4 py-3">
                                @item.Name
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="d-flex gap-2 justify-content-end align-items-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3">Ред.</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger rounded-pill px-3" onclick="return confirm('Ви впевнені, що хочете видалити цю тематику?');">Вид.</a>
                                </div>
                            </td>
                        </tr>
                    }
                } else {
                    <tr>
                        <td colspan="2" class="text-center text-muted p-5 fs-5">
                            Список тематик порожній
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>