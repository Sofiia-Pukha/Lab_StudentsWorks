@model WebMVC.Domain.Entities.Work

@{
    ViewData["Title"] = "Редагувати роботу";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h2 class="h4 mb-0 fw-bold">Редагування роботи</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="StudentId" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold small text-uppercase tracking-wider">Тема роботи</label>
                            <input asp-for="Title" class="form-control rounded-pill px-3 py-2" />
                            <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryId" class="form-label fw-bold small text-uppercase tracking-wider">Тематика</label>
                            <select asp-for="CategoryId" class="form-select rounded-pill px-3 py-2" asp-items="ViewBag.Categories"></select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TeacherId" class="form-label fw-bold small text-uppercase tracking-wider">Викладач</label>
                            <select asp-for="TeacherId" class="form-select rounded-pill px-3 py-2" asp-items="ViewBag.Teachers"></select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="ExecutionYear" class="form-label fw-bold small text-uppercase tracking-wider">Рік виконання</label>
                                <input asp-for="ExecutionYear" class="form-control rounded-pill px-3 py-2" type="number" />
                                <span asp-validation-for="ExecutionYear" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Grade" class="form-label fw-bold small text-uppercase tracking-wider">Бал (якщо є)</label>
                                <input asp-for="Grade" class="form-control rounded-pill px-3 py-2" type="number" />
                                <span asp-validation-for="Grade" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="FileUrl" class="form-label fw-bold small text-uppercase tracking-wider">Посилання на файл</label>
                            <input asp-for="FileUrl" class="form-control rounded-pill px-3 py-2" />
                            <span asp-validation-for="FileUrl" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 py-2 order-2 order-sm-1">Скасувати</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm order-1 order-sm-2">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}