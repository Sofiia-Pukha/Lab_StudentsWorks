@using System.Security.Claims
@model WebMVC.Domain.Entities.Work

@{
    ViewData["Title"] = "Опублікувати роботу";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <h2 class="h4 mb-0 fw-bold">Завантажити мою роботу</h2>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Прізвище та Ім'я автора (українською)</label>
                                <input name="StudentFullName" class="form-control rounded-pill px-3 py-2" placeholder="Наприклад: Шевченко Тарас" required />
                                <div class="form-text mt-2">Будь ласка, вказуйте дані згідно з паспортом для коректного формування рейтингу.</div>
                                
                                <input type="hidden" asp-for="StudentId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
                            </div>

                            <div class="col-md-12 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Тема роботи (Title)</label>
                                <input asp-for="Title" class="form-control rounded-pill px-3 py-2" placeholder="Наприклад: Розробка системи лояльності..." />
                                <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Викладач-керівник</label>
                                <select asp-for="TeacherId" class="form-select rounded-pill px-3 py-2" asp-items="ViewBag.Teachers">
                                    <option value="">-- Оберіть викладача --</option>
                                </select>
                                <span asp-validation-for="TeacherId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Категорія (Напрямок)</label>
                                <select asp-for="CategoryId" class="form-select rounded-pill px-3 py-2" asp-items="ViewBag.Categories">
                                    <option value="">-- Оберіть категорію --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Рік виконання</label>
                                <input asp-for="ExecutionYear" type="number" class="form-control rounded-pill px-3 py-2" value="@DateTime.Now.Year" />
                                <span asp-validation-for="ExecutionYear" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Отриманий бал</label>
                                <input asp-for="Grade" type="number" class="form-control rounded-pill px-3 py-2" placeholder="Напр: 95" min="0" max="100" />
                                <span asp-validation-for="Grade" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-12 mb-5">
                                <label class="form-label fw-bold small text-uppercase tracking-wider">Посилання на файл</label>
                                <input asp-for="FileUrl" class="form-control rounded-pill px-3 py-2" placeholder="https://..." />
                                <div class="form-text mt-2">Тільки посилання (Google Drive, GitHub тощо).</div>
                                <span asp-validation-for="FileUrl" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 py-2 order-2 order-sm-1">Назад до каталогу</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm order-1 order-sm-2">Опублікувати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>